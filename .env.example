# StudySnap deploy-time config (copy to .env, do not commit real values)

# Email to receive the $20 billing alarm (SNS confirmation required)
ALARM_EMAIL=you@example.com

# AWS region (verified backend)
AWS_REGION=us-east-1

# Primary Bedrock model (Haiku 4.5). Swap to Sonnet fallback if quality disappoints:
# us.anthropic.claude-sonnet-4-5-20250929-v1:0
AI_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
